# Build output
build/
Release/
.xmake/
.cache/
compile_commands.json
*.pdb
*.ilk
*.obj
*.exp

# Docs site built by mkdocs (the pages themselves are docs/ + mkdocs.yml)
/site/

# Third-party build inputs (about 1 GB), fetched by scripts\fetch-deps.ps1
extern/

# Voice models and speech-runtime files never belong in git, wherever they land
*.onnx
voices.bin
espeak-ng-data/
*.tar.bz2

# dist/ is the mod as installed. It is generated (DLL by xmake, scripts by Pyro,
# placeholder wavs by scripts\slots.lua, model by fetch-deps), except the
# hand-written config and the console command map
dist/**
!dist/SKSE/
!dist/SKSE/Plugins/
!dist/SKSE/Plugins/AudioUtilTTS/
!dist/SKSE/Plugins/AudioUtilTTS/AudioUtilTTS.toml
!dist/SKSE/Plugins/AudioUtilTTS/licenses/
!dist/SKSE/Plugins/AudioUtilTTS/licenses/*.txt
# a copy of LICENSE that scripts\package.lua places beside the other licenses
dist/SKSE/Plugins/AudioUtilTTS/licenses/GPL-3.0.txt
!dist/SKSE/CustomConsole/
!dist/SKSE/CustomConsole/*.yaml

# Machine-local: the Pyro project holds absolute paths to the game and to
# AudioUtil's sources
*.ppj

# Audio written by the probe (xmake run probe ... out.wav) and other scratch output
/*.wav
*.log
*.zip
*.7z

# Editors and IDEs
.vs/
.vscode/
.idea/
vsxmake*/
*.user
*.suo

# OS
Thumbs.db
Desktop.ini
.DS_Store
